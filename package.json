{
  "name": "skill-recorder",
  "version": "0.1.0",
  "description": "Records a user's on-screen work session and derives a structured description for building AI-agent skills.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.6",
    "ffmpeg-static": "^5.3.0",
    "get-windows": "^9.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.6",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "1.0.4"
  }
}
